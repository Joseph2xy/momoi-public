{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "momoi",
  "workers_dev": true,
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "triggers": { "crons": [] },
  "observability": {
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  }
}
